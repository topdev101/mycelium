# Copy this file to `.env` and fill in your key to enable real AI.
# Without a key, Mycelium runs in demo mode with realistic mock content.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (Azure/OpenRouter/local, etc.)
# OPENAI_BASE_URL=

# --- Server ---
REQUEST_TIMEOUT=40
DB_PATH=mycelium.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
